{
  "name": "Laravel MCP Chat (Tech Day)",
  "image": "mcr.microsoft.com/devcontainers/php:8.3",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "composer install && npm install && php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\" && php artisan key:generate && php artisan migrate --graceful --ansi || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-pack",
        "neilbrayfield.php-docblocker",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "shufo.vscode-blade-formatter"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Laravel",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "php artisan serve --host 0.0.0.0 --port 8000",
  "remoteUser": "vscode"
}
